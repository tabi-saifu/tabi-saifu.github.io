# Firebase コンソール > プロジェクトの設定 > マイアプリ（ウェブ）の firebaseConfig の値。
# どれも公開前提の値です。本番用は .env.production に書いてコミットします。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tabi-saifu.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=tabi-saifu
VITE_FIREBASE_APP_ID=
# 任意: Gmail ワンタップ送信を使う場合の Google OAuth クライアント ID
VITE_GOOGLE_CLIENT_ID=
